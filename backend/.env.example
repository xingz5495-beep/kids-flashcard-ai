# ============ 中转站 / OpenAI 兼容配置（以 NayutoAI 为例） ============

# 图像生成（通过 OpenAI 兼容接口）
OPENAI_API_KEY=sk-你的NayutoAI密钥
OPENAI_BASE_URL=https://api.nayutoai.xyz/v1
OPENAI_MODEL=gpt-image-2  # NayutoAI 的做图模型

# 文本/Claude（可选，如果你后面要用）
ANTHROPIC_API_KEY=sk-你的中转站或官方Claude密钥
ANTHROPIC_BASE_URL=https://api.nayutoai.xyz/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============ 官方直连（备用） ============
# OPENAI_API_KEY=sk-官方OpenAIKey
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-image-2
# ANTHROPIC_API_KEY=sk-ant-官方ClaudeKey
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 服务器端口
PORT=3000

# 环境设置
NODE_ENV=development
